<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/bg_primary">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/toolbox_title"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/export_frames_description"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tv_skeleton_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/no_skeleton_selected"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:background="@color/surface"
        android:padding="12dp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btn_select_skeleton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/select_skeleton_file"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/et_animation_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/animation_name_hint"
        android:inputType="text"
        android:padding="12dp"
        android:background="@color/surface"
        android:textSize="16sp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btn_export_frames"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/export_frames"
        android:backgroundTint="@color/accent"
        android:textColor="@android:color/white" />

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_marginTop="16dp" />

</LinearLayout>
