<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/bg_primary">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_title"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/default_folder_label"
        android:textSize="18sp"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tv_default_folder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/no_default_folder"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:background="@color/surface"
        android:padding="12dp"
        android:layout_marginBottom="16dp"
        android:minHeight="50dp"
        android:ellipsize="none"
        android:maxLines="5" />

    <Button
        android:id="@+id/btn_select_folder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/select_folder"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btn_clear_folder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/clear_default"
        style="@style/Widget.AppCompat.Button.Borderless"
        android:textColor="@color/accent"
        android:layout_marginBottom="24dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/text_secondary"
        android:layout_marginBottom="24dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/default_premultiply_alpha"
            android:textSize="16sp"
            android:textColor="@color/text_primary" />

        <Switch
            android:id="@+id/switch_default_premultiply"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </LinearLayout>

</LinearLayout>
